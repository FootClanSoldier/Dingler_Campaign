<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonDiffPatch.Net" Version="2.5.0" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <Reference Include="NCalc">
      <HintPath>..\DLLs\NCalc.dll</HintPath>
      <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
      <Private Condition="'$(Configuration)' == 'Release'">false</Private>
    </Reference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dingler.Data\Dingler.Data.csproj" />
    <ProjectReference Include="..\Dingler.Game.Protocol\Dingler.Game.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\DLLs\Assembly-CSharp-firstpass.dll</HintPath>
      <Aliases>HexGame</Aliases>
      <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
      <Private Condition="'$(Configuration)' == 'Release'">false</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>..\DLLs\ICSharpCode.SharpZipLib.dll</HintPath>
      <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
      <Private Condition="'$(Configuration)' == 'Release'">false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Campaign/Definitions/EncounterRewards.json" LogicalName="Dingler.Game.Campaign.Definitions.EncounterRewards.json" />
    <EmbeddedResource Include="Campaign/Definitions/QuestRewards.json" LogicalName="Dingler.Game.Campaign.Definitions.QuestRewards.json" />
    <EmbeddedResource Include="Campaign/Definitions/RewardDisplayOrder.json" LogicalName="Dingler.Game.Campaign.Definitions.RewardDisplayOrder.json" />
    <EmbeddedResource Include="Campaign/Definitions/Az1Map.json" LogicalName="Dingler.Game.Campaign.Definitions.Az1Map.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Cards\CardRepresentationExtensions.cs" />
  </ItemGroup>

</Project>

{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Infinite"
        }
      }
    ]
  },
  "GamedataLocation": "/Path/To/Main/HEX SHARDS OF FATE/Installation/Directory",
  "Dingler": {
    "Endpoints": {
      "TCP": {
        "Url": "127.0.0.1",
        "Port": "9933"
      }
    }
  },
  "ConnectionStrings": {
    "GameData": "Data Source=data/gameData.db"
  },
  "Auth": {
    "BaseUrl": "http://localhost:5000"
  },
  "DeckImport": {
    "SiteDataPath": ""
  },
  "Campaign": {
    "StorePath": "data/campaign",
    "DefaultRace": 1,
    "BootstrapChampion": true,
    "BootstrapChampionName": "CampaignTest",
    "BootstrapChampionClass": 3,
    "BootstrapChampionGender": 1
  }
}
